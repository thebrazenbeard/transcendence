{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thebrazenbeard/transcendence/schemas/hcsa-v0.schema.json",
  "title": "Transcendence Human Cognitive State Archive V0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "archive_id",
    "subject_ref",
    "archive_version",
    "created_at",
    "records",
    "snapshots",
    "lineage"
  ],
  "properties": {
    "schema_id": {"const": "TRANSCENDENCE_HCSA_V0"},
    "archive_id": {"type": "string", "minLength": 1},
    "subject_ref": {"type": "string", "minLength": 1},
    "archive_version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/snapshot"}
    },
    "lineage": {
      "type": "array",
      "items": {"$ref": "#/$defs/lineage_operation"}
    },
    "extensions": {"type": "object"}
  },
  "$defs": {
    "payload_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "digest"],
      "properties": {
        "media_type": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "uri": {"type": "string", "minLength": 1}
      }
    },
    "temporal_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instant": {"type": "string", "minLength": 1},
        "start": {"type": "string", "minLength": 1},
        "end": {"type": "string", "minLength": 1}
      },
      "anyOf": [
        {"required": ["instant"]},
        {"required": ["start"]},
        {"required": ["end"]}
      ]
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": true,
      "required": ["method"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "adapter_id": {"type": "string"},
        "device_id": {"type": "string"},
        "context": {"type": "object"}
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["method_id", "input_record_ids", "information_discarded"],
      "properties": {
        "method_id": {"type": "string", "minLength": 1},
        "model_version": {"type": "string"},
        "input_record_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "information_discarded": {
          "type": "array",
          "items": {"type": "string"}
        },
        "parameters": {"type": "object"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "provenance_class",
        "domain",
        "temporal_scope",
        "payload_ref",
        "source_record_ids",
        "authority_ref"
      ],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "provenance_class": {
          "enum": [
            "MEASURED",
            "BEHAVIORALLY_OBSERVED",
            "SELF_REPORTED",
            "DERIVED",
            "INFERRED",
            "INTERPOLATED",
            "GENERATED",
            "IMPORTED_REFERENCE",
            "UNKNOWN"
          ]
        },
        "domain": {
          "enum": [
            "STRUCTURAL",
            "EFFECTIVE_CONNECTIVITY",
            "CELLULAR_MOLECULAR",
            "DYNAMIC_NEURAL",
            "EMBODIED_REGULATORY",
            "COGNITIVE_PHENOTYPE",
            "LONGITUDINAL_SHADOW",
            "BCI_RAW",
            "BCI_NORMALIZED",
            "OTHER"
          ]
        },
        "temporal_scope": {"$ref": "#/$defs/temporal_scope"},
        "payload_ref": {"$ref": "#/$defs/payload_ref"},
        "source_record_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "supersedes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "acquisition": {"$ref": "#/$defs/acquisition"},
        "transformation": {"$ref": "#/$defs/transformation"},
        "authority_ref": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "object"},
        "extensions": {"type": "object"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "record_ids", "created_at", "unknown_coverage"],
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1},
        "record_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "created_at": {"type": "string", "minLength": 1},
        "unknown_coverage": {
          "type": "array",
          "items": {"type": "string"}
        },
        "extensions": {"type": "object"}
      }
    },
    "lineage_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "operation",
        "occurred_at",
        "parent_snapshot_ids",
        "child_snapshot_ids"
      ],
      "properties": {
        "operation_id": {"type": "string", "minLength": 1},
        "operation": {
          "enum": ["BACKUP", "RESTORE", "SUCCESSOR", "FORK", "MIGRATION", "GRADUAL_TRANSFER"]
        },
        "occurred_at": {"type": "string", "minLength": 1},
        "parent_snapshot_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "child_snapshot_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "extensions": {"type": "object"}
      }
    }
  }
}
