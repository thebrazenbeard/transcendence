{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebrazenbeard.github.io/transcendence/schemas/hcsa-v0.schema.json",
  "title": "Human Cognitive State Archive V0",
  "type": "object",
  "required": ["schema_version", "archive_id", "subject_ref", "created_at", "records", "snapshots"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "HCSA_V0"},
    "archive_id": {"type": "string", "minLength": 1},
    "subject_ref": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    },
    "snapshots": {
      "type": "array",
      "items": {"$ref": "#/$defs/snapshot"}
    }
  },
  "$defs": {
    "authority": {
      "type": "object",
      "required": ["storage", "read", "research", "training", "interpretation", "reconstruction", "activation", "replication", "disclosure"],
      "additionalProperties": false,
      "properties": {
        "storage": {"type": "boolean"},
        "read": {"type": "boolean"},
        "research": {"type": "boolean"},
        "training": {"type": "boolean"},
        "interpretation": {"type": "boolean"},
        "reconstruction": {"type": "boolean"},
        "activation": {"type": "boolean"},
        "replication": {"type": "boolean"},
        "disclosure": {"type": "boolean"}
      }
    },
    "record": {
      "type": "object",
      "required": [
        "record_id", "provenance", "captured_at", "payload_ref",
        "privacy_class", "authority", "integrity"
      ],
      "additionalProperties": false,
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "provenance": {
          "enum": [
            "MEASURED", "BEHAVIORALLY_OBSERVED", "SELF_REPORTED", "DERIVED",
            "INFERRED", "INTERPOLATED", "GENERATED", "IMPORTED_REFERENCE", "UNKNOWN"
          ]
        },
        "source_record_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "capture_method": {"type": ["string", "null"]},
        "captured_at": {"type": "string", "format": "date-time"},
        "biological_interval": {"type": ["string", "null"]},
        "scope": {"type": ["string", "null"]},
        "payload_ref": {"type": "string", "minLength": 1},
        "representation": {"type": ["string", "null"]},
        "units": {"type": ["string", "null"]},
        "uncertainty": {"type": ["number", "null"], "minimum": 0},
        "model_version": {"type": ["string", "null"]},
        "supersedes": {"type": ["string", "null"]},
        "privacy_class": {"enum": ["PUBLIC", "PRIVATE", "SENSITIVE", "RESTRICTED"]},
        "authority": {"$ref": "#/$defs/authority"},
        "integrity": {
          "type": "object",
          "required": ["algorithm", "digest"],
          "additionalProperties": false,
          "properties": {
            "algorithm": {"const": "SHA-256"},
            "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "required": ["snapshot_id", "cutoff_at", "record_ids", "unresolved_conflicts", "unknowns"],
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1},
        "cutoff_at": {"type": "string", "format": "date-time"},
        "record_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "unresolved_conflicts": {"type": "array", "items": {"type": "string"}},
        "unknowns": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}