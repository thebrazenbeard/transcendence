{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebrazenbeard.github.io/transcendence/specs/bci-adapter-v0.schema.json",
  "title": "BCI Adapter V0",
  "type": "object",
  "required": [
    "schema_version",
    "adapter_id",
    "adapter_version",
    "direction",
    "modalities",
    "raw_representation"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "BCI-ADAPTER-V0"
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "enum": [
        "ACQUIRE",
        "EFFECT",
        "BIDIRECTIONAL"
      ]
    },
    "modalities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "raw_representation": {
      "type": "string",
      "minLength": 1
    },
    "spatial_resolution": {
      "type": [
        "object",
        "null"
      ]
    },
    "temporal_resolution": {
      "type": [
        "object",
        "null"
      ]
    },
    "calibration_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "decoder_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "uncertainty": {
      "type": [
        "object",
        "null"
      ]
    },
    "semantic_interpretation": {
      "type": [
        "object",
        "null"
      ]
    },
    "effect_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effect_authority_scope": {
      "type": "object"
    },
    "subject_state_context": {
      "type": "object"
    }
  }
}