{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebrazenbeard.github.io/transcendence/specs/bci-adapter-v0.schema.json",
  "title": "BCI Adapter V0",
  "type": "object",
  "required": [
    "schema_version",
    "adapter_id",
    "adapter_version",
    "direction",
    "modalities",
    "raw_representation",
    "normalization",
    "uncertainty_model",
    "effect_capabilities",
    "effect_authority_scope"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "BCI-ADAPTER-V0"
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "enum": [
        "ACQUIRE",
        "EFFECT",
        "BIDIRECTIONAL"
      ]
    },
    "modalities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "raw_representation": {
      "type": "string",
      "minLength": 1
    },
    "spatial_resolution": {
      "type": [
        "object",
        "null"
      ]
    },
    "temporal_resolution": {
      "type": [
        "object",
        "null"
      ]
    },
    "coverage": {
      "type": [
        "string",
        "null"
      ]
    },
    "calibration_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "normalization": {
      "type": "object",
      "required": [
        "version",
        "preserves_raw_reference"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "preserves_raw_reference": {
          "const": true
        }
      }
    },
    "decoder": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "interpretation_provenance": {
          "enum": [
            "DERIVED",
            "INFERRED",
            "INTERPOLATED",
            "GENERATED",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "version",
        "interpretation_provenance"
      ],
      "additionalProperties": false
    },
    "uncertainty_model": {
      "type": "string",
      "minLength": 1
    },
    "effect_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "effect_authority_scope": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "allowed_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "scope_id",
        "allowed_effects"
      ],
      "additionalProperties": false
    },
    "subject_state_context": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "direction": {
            "const": "ACQUIRE"
          }
        }
      },
      "then": {
        "properties": {
          "effect_capabilities": {
            "maxItems": 0
          },
          "effect_authority_scope": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "direction": {
            "enum": [
              "EFFECT",
              "BIDIRECTIONAL"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "effect_capabilities": {
            "minItems": 1
          },
          "effect_authority_scope": {
            "type": "object"
          }
        }
      }
    }
  ]
}
