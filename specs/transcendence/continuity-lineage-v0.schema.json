{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebrazenbeard.github.io/transcendence/specs/continuity-lineage-v0.schema.json",
  "title": "Continuity Lineage V0",
  "type": "object",
  "required": [
    "schema_version",
    "lineage_id",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "CONTINUITY-LINEAGE-V0"
    },
    "lineage_id": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "substrate": {
      "type": "object",
      "required": [
        "substrate_id",
        "substrate_class",
        "role",
        "interval"
      ],
      "additionalProperties": false,
      "properties": {
        "substrate_id": {
          "type": "string",
          "minLength": 1
        },
        "substrate_class": {
          "enum": [
            "BIOLOGICAL",
            "SYNTHETIC",
            "HYBRID",
            "EMULATED",
            "NEUROMORPHIC",
            "UNKNOWN"
          ]
        },
        "role": {
          "enum": [
            "SOURCE",
            "TARGET",
            "OVERLAPPING_ACTIVE",
            "ARCHIVAL_ONLY"
          ]
        },
        "interval": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "status",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "UNKNOWN",
            "UNESTABLISHED",
            "CONTRADICTED",
            "NOT_APPLICABLE"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "SUPPORTED",
                  "PARTIAL"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "required": [
        "event_id",
        "event_type",
        "occurred_at",
        "predecessor_snapshot_ids",
        "descendant_snapshot_ids",
        "substrates",
        "evidence_refs",
        "continuity_claims",
        "unresolved_questions"
      ],
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "enum": [
            "BACKUP",
            "RESTORE",
            "SUCCESSOR",
            "FORK",
            "MIGRATION",
            "GRADUAL_TRANSFER"
          ]
        },
        "occurred_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "predecessor_snapshot_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "descendant_snapshot_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "substrates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/substrate"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "continuity_claims": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "BIOLOGICAL": {
              "$ref": "#/$defs/claim"
            },
            "AUTOBIOGRAPHICAL_INFORMATIONAL": {
              "$ref": "#/$defs/claim"
            },
            "PSYCHOLOGICAL": {
              "$ref": "#/$defs/claim"
            },
            "FUNCTIONAL": {
              "$ref": "#/$defs/claim"
            },
            "CAUSAL_NEURAL": {
              "$ref": "#/$defs/claim"
            },
            "TEMPORAL_PROCESS": {
              "$ref": "#/$defs/claim"
            },
            "PHENOMENAL_SUBJECTIVE": {
              "$ref": "#/$defs/claim"
            }
          }
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "FORK"
              }
            }
          },
          "then": {
            "properties": {
              "descendant_snapshot_ids": {
                "minItems": 2
              }
            }
          }
        }
      ]
    }
  }
}
