{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebrazenbeard.github.io/transcendence/specs/continuity-lineage-v0.schema.json",
  "title": "Continuity Lineage V0",
  "type": "object",
  "required": [
    "schema_version",
    "events"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "CONTINUITY-LINEAGE-V0"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "event_type",
          "occurred_at",
          "predecessor_snapshot_ids",
          "descendant_snapshot_ids",
          "substrates",
          "continuity_claims"
        ],
        "additionalProperties": true,
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "event_type": {
            "enum": [
              "BACKUP",
              "RESTORE",
              "SUCCESSOR",
              "FORK",
              "MIGRATION",
              "GRADUAL_TRANSFER"
            ]
          },
          "occurred_at": {
            "type": "string",
            "minLength": 1
          },
          "predecessor_snapshot_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "descendant_snapshot_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "substrates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "continuity_claims": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "status",
                "evidence_refs"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}